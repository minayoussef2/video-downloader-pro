<Window x:Class="VideoDownloaderPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoDownloaderPro.ViewModels"
        Title="Video Downloader Pro v3.0" Height="780" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Icon="/icon.ico"
        Background="{StaticResource BgPrimaryBrush}">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR ═══ -->
        <Border Grid.Column="0" Background="{StaticResource BgSecondaryBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                    <TextBlock Text="⬇ Video Downloader" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Pro v3.0" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="Extension Server" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="8,0"/>
                    <StackPanel Orientation="Horizontal" Margin="8,4,0,0">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreenBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="Running on :18888" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Buttons -->
                <StackPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource NavBtn}" Content="▶  Downloads"
                            Command="{Binding NavigateCommand}" CommandParameter="Downloads"/>
                    <Button Style="{StaticResource NavBtn}" Content="🔗  HLS Downloader"
                            Command="{Binding NavigateCommand}" CommandParameter="HLS"/>
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="16,8"/>
                    <Button Style="{StaticResource NavBtn}" Content="🕓  History"
                            Command="{Binding NavigateCommand}" CommandParameter="History"/>
                    <Button Style="{StaticResource NavBtn}" Content="📊  Statistics"
                            Command="{Binding NavigateCommand}" CommandParameter="Stats"/>
                    <Button Style="{StaticResource NavBtn}" Content="⚙  Settings"
                            Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ MAIN CONTENT ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Downloads Tab -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVis}, ConverterParameter=Downloads}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Margin="24,20,24,8">
                    <TextBlock Text="▶ Video Downloader" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="YouTube · Facebook · Instagram · Any supported site" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- URL Input -->
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="24,4,24,8" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Paste video or playlist URLs (one per line):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource InputBox}" Text="{Binding UrlInput, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Height="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="➕ Add to Queue"
                                        Command="{Binding AddUrlsCommand}" Padding="20,10" IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvBoolToVis}}"/>
                                <Button Style="{StaticResource BtnGhost}" Content="🗑 Clear All"
                                        Command="{Binding ClearAllCommand}" Margin="0,8,0,0" Padding="20,8"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Queue Controls -->
                <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="24,0,24,8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding QueueCount, StringFormat='Queue: {0} items'}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="8,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                            <TextBlock Text="Set all:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding QualityOptions}"
                                      SelectedItem="{Binding GlobalQuality}" MinWidth="130"/>
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="⬇ Download All"
                                Command="{Binding DownloadAllCommand}" Padding="14,6" Margin="4,0"/>
                        <Button Grid.Column="4" Style="{StaticResource BtnWarning}" Content="⏸ Pause All"
                                Command="{Binding PauseAllCommand}" Padding="14,6" Margin="4,0"/>
                        <Button Grid.Column="5" Style="{StaticResource BtnDanger}" Content="✕ Cancel All"
                                Command="{Binding CancelAllCommand}" Padding="14,6" Margin="4,0"/>
                    </Grid>
                </Border>

                <!-- Queue List -->
                <ScrollViewer Grid.Row="3" Margin="24,0,24,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DownloadQueue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Thumbnail placeholder -->
                                        <Border Grid.RowSpan="2" Width="140" Height="80" CornerRadius="8"
                                                Background="{StaticResource BgTertiaryBrush}" Margin="0,0,12,0">
                                            <TextBlock Text="🎬" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextMutedBrush}"/>
                                        </Border>

                                        <!-- Title + Remove -->
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="✕" Padding="6,2"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" FontSize="11"/>
                                        </Grid>

                                        <!-- Meta -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,4">
                                            <Run Text="{Binding Duration}"/> · <Run Text="{Binding Uploader}"/>
                                        </TextBlock>

                                        <!-- Options Row -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,4">
                                            <TextBlock Text="Quality:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox Style="{StaticResource DarkComboBox}" MinWidth="140"
                                                      ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding SelectedQuality}"/>
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       VerticalAlignment="Center" Margin="12,0"/>
                                            <TextBlock Text="Format:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox Style="{StaticResource DarkComboBox}" MinWidth="80"
                                                      ItemsSource="{Binding DataContext.FormatOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding SelectedFormat}"/>
                                        </StackPanel>

                                        <!-- Progress + Buttons -->
                                        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <ProgressBar Style="{StaticResource ModernProgress}" Value="{Binding Progress}" Height="4" Margin="0,0,0,6"/>
                                            <Grid Grid.Row="1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Fragments, StringFormat='  •  Frags: {0}'}" FontSize="11" Foreground="{StaticResource AccentBlueBrush}" 
                                                               Visibility="{Binding Fragments, Converter={StaticResource StringToVis}}"/>
                                                </StackPanel>
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button Style="{StaticResource BtnPrimary}" Content="⬇ Download" Padding="12,5" FontSize="11"
                                                            Command="{Binding DataContext.DownloadItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource BtnWarning}" Content="⏸" Padding="8,5" Margin="4,0,0,0" FontSize="11"
                                                            Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource BtnDanger}" Content="✕" Padding="8,5" Margin="4,0,0,0" FontSize="11"
                                                            Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- HLS Tab (similar structure) -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVis}, ConverterParameter=HLS}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="24,20,24,8">
                    <TextBlock Text="🔗 HLS / M3U8 Downloader" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}" CornerRadius="12" Margin="24,4,24,8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Referer URL:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding HlsReferer, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="M3U8 URLs (one per line):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding HlsUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                        
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Set all:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding QualityOptions}"
                                          SelectedItem="{Binding GlobalHlsQuality}" MinWidth="110"/>
                                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding FormatOptions}"
                                          SelectedItem="{Binding GlobalHlsFormat}" MinWidth="80" Margin="4,0,0,0"/>
                            </StackPanel>
                            
                            <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Content="➕ Add to Queue" Command="{Binding AddHlsUrlsCommand}" Margin="12,0,0,0" Padding="14,6"/>
                            <Button Grid.Column="4" Style="{StaticResource BtnSuccess}" Content="⬇ Download All" Command="{Binding HlsDownloadAllCommand}" Margin="4,0,0,0" Padding="14,6"/>
                            <Button Grid.Column="5" Style="{StaticResource BtnGhost}" Content="🗑 Clear All" Command="{Binding ClearAllCommand}" Margin="4,0,0,0" Padding="14,6"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="2" Margin="24,0,24,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding HlsQueue}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCardBrush}" CornerRadius="12"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="✕" Padding="6,2"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" FontSize="11"/>
                                        </Grid>

                                        <!-- Options Row -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,4">
                                            <TextBlock Text="Quality:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <ComboBox Style="{StaticResource DarkComboBox}" MinWidth="120"
                                                      ItemsSource="{Binding AvailableQualities}" SelectedItem="{Binding SelectedQuality}"/>
                                            <TextBlock Text="Format:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                            <ComboBox Style="{StaticResource DarkComboBox}" MinWidth="80"
                                                      ItemsSource="{Binding DataContext.FormatOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding SelectedFormat}"/>
                                        </StackPanel>

                                        <ProgressBar Grid.Row="2" Style="{StaticResource ModernProgress}" Value="{Binding Progress}" Margin="0,4,0,6" Height="4"/>

                                        <Grid Grid.Row="3">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource BtnPrimary}" Content="⬇ Download" Padding="12,5" FontSize="11"
                                                        Command="{Binding DataContext.DownloadItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource BtnWarning}" Content="⏸" Padding="8,5" Margin="4,0,0,0" FontSize="11"
                                                        Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource BtnDanger}" Content="✕" Padding="8,5" Margin="4,0,0,0" FontSize="11"
                                                        Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- History Tab -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVis}, ConverterParameter=History}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="24,20,24,12">
                    <TextBlock Text="🕓 Download History" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource BtnGhost}" Content="📁 Open Folder" Command="{Binding OpenDownloadFolderCommand}" Margin="16,0,0,0" Padding="12,6"/>
                    <Button Style="{StaticResource BtnGhost}" Content="🗑 Clear" Command="{Binding ClearHistoryCommand}" Margin="8,0,0,0" Padding="12,6"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Margin="24,0,24,8" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Margin="0,0,0,6" Padding="14,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0">
                                                <Run Text="{Binding Quality}"/> · <Run Text="{Binding Format}"/> · <Run Text="{Binding Timestamp}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Stats Tab -->
            <Grid Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVis}, ConverterParameter=Stats}">
                <StackPanel Margin="24,20">
                    <TextBlock Text="📊 Statistics" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="Total Downloads" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Stats.TotalVideos}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Total Data" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Stats.TotalDataMb, StringFormat='{}{0:F1} MB'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Session Downloads" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Stats.SessionVideos}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Session Data" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Stats.SessionDataMb, StringFormat='{}{0:F1} MB'}" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentOrangeBrush}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>

            <!-- Settings Tab -->
            <ScrollViewer Visibility="{Binding SelectedTab, Converter={StaticResource BoolToVis}, ConverterParameter=Settings}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,20">
                    <TextBlock Text="⚙ Settings" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <!-- Download Folder -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Download Folder" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource InputBox}" Text="{Binding Settings.DownloadPath, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource BtnGhost}" Content="Browse" Command="{Binding BrowsePathCommand}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Default Quality & Format -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Defaults" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Quality:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding Settings.DefaultQuality}"/>
                                <TextBlock Text="Format:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="20,0,8,0"/>
                                <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding Settings.DefaultFormat}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Concurrency -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Download Behavior" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Max concurrent downloads (1 = one at a time)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="1" Maximum="10" Width="200" Value="{Binding Settings.MaxConcurrentDownloads}"
                                        IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Text="{Binding Settings.MaxConcurrentDownloads}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="12,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Parallel fragment connections per download" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,12,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="1" Maximum="16" Width="200" Value="{Binding Settings.ConcurrentFragments}"
                                        IsSnapToTickEnabled="True" TickFrequency="1"/>
                                <TextBlock Text="{Binding Settings.ConcurrentFragments}" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBlueBrush}" Margin="12,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- System -->
                    <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="System" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                            <CheckBox Content="Start on Windows startup" IsChecked="{Binding Settings.StartOnStartup}"
                                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <CheckBox Content="Minimize to system tray instead of closing" IsChecked="{Binding Settings.MinimizeToTray}"
                                      Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <CheckBox Content="Auto-install browser extension on startup" IsChecked="{Binding Settings.AutoInstallExtension}"
                                      Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource BtnSuccess}" Content="💾 Save All Settings"
                            Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"
                            Padding="24,12" FontSize="14" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" Padding="16,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1" Style="{StaticResource ModernProgress}" Value="{Binding OverallProgress}"
                                 Margin="16,0,0,0" Height="6"/>
                </Grid>
            </Border>
            <!-- ═══ STATUS BAR ═══ -->
            <Border Grid.Row="1" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Total Estimated Size:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding TotalSizeSum}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                    
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Active Downloads:" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding QueueCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
