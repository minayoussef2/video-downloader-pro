<Window x:Class="VideoDownloaderPro.Views.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Error Details" Height="420" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#0A0A0F" Foreground="#F3F4F6"
        ResizeMode="CanResize" Icon="pack://application:,,,/icon.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="BgCardBrush" Color="#161622"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2A3C"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F3F4F6"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF"/>
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6366F1" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚠️ Full Download Error Details" FontSize="18" FontWeight="Bold" Foreground="#F87171"/>
            <TextBlock Text="Review stderr and log output for this failed download item:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Error Text Box -->
        <Border Grid.Row="1" Background="#0D0D14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <TextBox x:Name="TxtError" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Background="Transparent" Foreground="#FCA5A5" BorderThickness="0" FontFamily="Consolas, Courier New" FontSize="12"/>
        </Border>

        <!-- Action Bar -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="📋 Copy Error Details" Click="Copy_Click"
                    Padding="14,8" FontSize="12" FontWeight="Bold"
                    Background="{StaticResource AccentGradient}" Foreground="White" BorderThickness="0"
                    Cursor="Hand"/>

            <Button Grid.Column="2" Content="Close" Click="Close_Click"
                    Padding="16,8" FontSize="12" FontWeight="SemiBold"
                    Background="#1E1E2E" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
